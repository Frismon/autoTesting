{
  "info": {
    "name": "Orders API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "token", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Secret123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 201', () => pm.response.to.have.status(201));",
              "pm.test('сума з доставкою', () => {",
              "  pm.expect(pm.response.json().total).to.eql(560);",
              "});",
              "pm.collectionVariables.set('orderId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [{ \"sku\": \"SKU-A\", \"price\": 500, \"qty\": 1 }]\n}"
        },
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "Get order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('те саме замовлення', () => {",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/orders/{{orderId}}"
      }
    }
  ]
}
